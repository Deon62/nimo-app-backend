# Copy to .env and fill in. Never commit .env.

APP_ENV=development
# Comma-separated origins allowed by CORS (Expo web dev server, etc.)
CORS_ORIGINS=http://localhost:8081
# Public HTTPS URL of this API (used for M-Pesa callbacks). On Render leave empty: RENDER_EXTERNAL_URL is used.
# Locally, use an ngrok/cloudflared URL.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still signs JWTs with the legacy shared secret (HS256).
SUPABASE_JWT_SECRET=

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Used for agents without their own voice yet (Ryan).
ELEVENLABS_FALLBACK_VOICE_ID=L0Dsvb3SLTyegXwtm47J

# Paystack (cards)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
# Where Paystack sends the user after paying (a deep link or web page)
PAYSTACK_CALLBACK_URL=nimo://payment-complete

# Safaricom Daraja (M-Pesa STK push)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random string; part of the callback URL so only Safaricom (who knows the URL) can hit it.
DARAJA_CALLBACK_TOKEN=change-me-to-a-long-random-string

# Prices are set in USD and charged in KES at this rate.
USD_TO_KES=129
